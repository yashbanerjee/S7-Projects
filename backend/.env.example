# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/project_s7?schema=public"

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Admin seed
ADMIN_EMAIL=admin@projects7.com
ADMIN_PASSWORD=Admin@S7Secure2026
ADMIN_NAME=Project S7 Admin

# Cloudinary (optional – falls back to local uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_CLOUDINARY=false

# Email / Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Project S7 <noreply@projects7.com>"
NOTIFY_EMAIL=admin@projects7.com

# Uploads
MAX_FILE_SIZE_MB=10
